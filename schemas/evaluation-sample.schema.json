{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lessons in Cast human evaluation sample",
  "type": "object",
  "additionalProperties": false,
  "required": ["dialogue_id", "expected"],
  "properties": {
    "dialogue_id": {"type": "string", "minLength": 1},
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "spoken_text", "emotion"],
      "properties": {
        "action": {
          "type": "string",
          "enum": ["speak", "omit", "sfx_only", "speak_with_effect"]
        },
        "spoken_text": {"type": "string"},
        "emotion": {"type": ["string", "null"]}
      }
    }
  }
}
